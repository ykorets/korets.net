---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { current?: string; bare?: boolean; title: string; description: string; path: string; image?: string; noindex?: boolean; type?: string; jsonld?: string }
const { current = '', bare = false, title, description, path, image = '/img/og-default.jpg', noindex = false, type = 'website', jsonld } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const img = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" type="application/rss+xml" title="Yaro Korets — Writing" href="/writing/feed.xml">
  <meta name="theme-color" content="#0B0A12">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={img}>
  <meta property="og:site_name" content="Yaro Korets">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {jsonld && <script type="application/ld+json" set:html={jsonld} />}
  <slot name="head" />
</head>
<body>
  {!bare && <SiteHeader current={current} />}
  <main id="main"><slot /></main>
  {!bare && <SiteFooter />}
  <script>import '../scripts/motion';</script>
</body>
</html>
