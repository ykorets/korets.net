---
// Generated from the approved design canvas (NotFound.dc.html); edit freely.
const { state = {}, props: p = {} } = Astro.props;
class DCLogic { constructor(props) { this.props = props || {}; this.state = {}; } setState() {} componentDidMount() {} }
class Component extends DCLogic {
  renderVals() {
    const motion = this.props.motion ?? true;
    const cards = [
      ['/#work', 'Work with me', 'How a project starts: one process, a baseline, a goal.'],
      ['https://growthcontrol.app', 'Growth Control', 'The AI team that runs operations end to end.'],
      ['/writing/', 'Writing', 'Field notes: built, shipped, running.'],
      ['https://book.korets.net', 'Book a call', '45 minutes to talk about your operation.']
    ].map((c) => ({ href: c[0], title: c[1], body: c[2] }));
    return {
      accent: this.props.accent ?? '#6D4AF6',
      rootClass: motion ? 'nf motion' : 'nf',
      cards: cards
    };
  }
}
const c = new Component(p);
Object.assign(c.state, state);
const v = c.renderVals();
---
<div class={v.rootClass} style={`--accent: ${v.accent}; position: relative; min-height: 900px; background: #0B0A12; color: #F4F2FF; font-family: 'Geist Variable', Inter, system-ui, sans-serif; overflow: hidden; display: flex; flex-direction: column`}>
  <div class="nf-grid" aria-hidden="true" style="position: absolute; inset: 0; pointer-events: none"></div>

  <main style="position: relative; z-index: 2; flex: 1; width: 100%; max-width: 1280px; margin: 0 auto; padding: 24px 32px 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px">
    <section style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
      <div style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; background: rgba(255,255,255,.03); font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 12px; color: #8B84A8; letter-spacing: .04em">
        <span class="nf-blink" style="width: 7px; height: 7px; border-radius: 50%; background: #F59E0B; display: inline-block"></span>
        ERROR 404 · NODE NOT FOUND
      </div>
      <h1 style="margin: 0; font-size: clamp(44px, 6vw, 80px); line-height: 1; letter-spacing: -0.045em; font-weight: 600">This page isn't<br>part of the system.</h1>
      <p style="margin: 0; font-size: 18px; line-height: 1.6; color: #A9A3C2; max-width: 520px">The link may be old, or the page has moved. Everything that works is one step away.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 14px">
        <a class="nf-cta" href="/" style="color: #FFFFFF; background: var(--accent); padding: 16px 26px; border-radius: 999px; font-size: 16px; font-weight: 500; min-height: 52px; display: inline-flex; align-items: center">Back to home</a>
        <a href="mailto:yaroslav@korets.net" style="color: #E4E0F5; border: 1px solid rgba(255,255,255,.18); padding: 16px 26px; border-radius: 999px; font-size: 16px; font-weight: 500; min-height: 52px; display: inline-flex; align-items: center">Report a broken link</a>
      </div>
    </section>

    <section aria-hidden="true" style="flex: 1 1 460px; min-width: 0; display: flex; justify-content: center">
      <div style="position: relative; width: 100%; max-width: 520px; aspect-ratio: 520 / 420">
        <svg viewBox="0 0 520 420" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible">
          <path d="M80 90 C 170 90, 170 210, 260 210" fill="none" stroke="rgba(167,139,250,.18)" stroke-width="1.5"></path>
          <path d="M440 90 C 350 90, 350 210, 260 210" fill="none" stroke="rgba(167,139,250,.18)" stroke-width="1.5"></path>
          <path d="M80 330 C 170 330, 170 210, 260 210" fill="none" stroke="rgba(167,139,250,.18)" stroke-width="1.5"></path>
          <path class="nf-flow" d="M80 90 C 170 90, 170 210, 260 210" fill="none" stroke="#A78BFA" stroke-width="1.5"></path>
          <path class="nf-flow" d="M440 90 C 350 90, 350 210, 260 210" fill="none" stroke="#A78BFA" stroke-width="1.5"></path>
          <path class="nf-flow" d="M80 330 C 170 330, 170 210, 260 210" fill="none" stroke="#A78BFA" stroke-width="1.5"></path>
          <path class="nf-flicker" d="M260 210 C 320 210, 330 270, 360 300" fill="none" stroke="#F59E0B" stroke-width="1.5" stroke-dasharray="3 7"></path>
        </svg>
        <div style="position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 118px; height: 118px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #8B6CFF 0%, var(--accent) 45%, #2A1D6B 100%); box-shadow: 0 0 60px color-mix(in srgb, var(--accent) 55%, transparent); display: flex; align-items: center; justify-content: center; font-size: 34px; font-weight: 600; letter-spacing: -0.03em">404</div>
        <span style="position: absolute; left: 15%; top: 21%; transform: translate(-50%,-50%); padding: 12px 14px; border-radius: 14px; background: rgba(20,17,36,.8); border: 1px solid rgba(167,139,250,.28); font-size: 14px; font-weight: 600">Home</span>
        <span style="position: absolute; left: 85%; top: 21%; transform: translate(-50%,-50%); padding: 12px 14px; border-radius: 14px; background: rgba(20,17,36,.8); border: 1px solid rgba(167,139,250,.28); font-size: 14px; font-weight: 600">Writing</span>
        <span style="position: absolute; left: 15%; top: 79%; transform: translate(-50%,-50%); padding: 12px 14px; border-radius: 14px; background: rgba(20,17,36,.8); border: 1px solid rgba(167,139,250,.28); font-size: 14px; font-weight: 600">CV</span>
        <div style="position: absolute; left: 78%; top: 80%">
          <span class="nf-drift" style="display: inline-flex; flex-direction: column; gap: 3px; padding: 12px 14px; border-radius: 14px; background: rgba(245,158,11,.06); border: 1px dashed rgba(245,158,11,.55)">
            <span style="font-size: 14px; font-weight: 600; color: #FCD34D">This page</span>
            <span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px; color: #B4A27A">disconnected</span>
          </span>
        </div>
      </div>
    </section>
  </main>

  <section style="position: relative; z-index: 2; width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 32px 48px; display: flex; flex-direction: column; gap: 16px">
    <span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 12px; letter-spacing: .1em; color: #8B84A8">TRY ONE OF THESE</span>
    <div style="display: flex; flex-wrap: wrap; gap: 14px">
      {(v.cards || []).map((c) => (<Fragment>
        <a class="nf-card" href={c.href} style="flex: 1 1 220px; min-width: 0; border-radius: 18px; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.03); padding: 20px; display: flex; flex-direction: column; gap: 6px; color: #F4F2FF">
          <span style="font-size: 17px; font-weight: 600">{c.title}</span>
          <span style="font-size: 14px; line-height: 1.5; color: #A9A3C2">{c.body}</span>
        </a>
      </Fragment>))}
    </div>
  </section>
</div>

<style is:global>
.nf *{box-sizing:border-box}
.nf a{text-decoration:none}
.nf-grid{background-image:radial-gradient(rgba(167,139,250,.16) 1px,transparent 1px);background-size:28px 28px;-webkit-mask-image:radial-gradient(ellipse 60% 60% at 50% 45%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse 60% 60% at 50% 45%,#000 30%,transparent 80%)}
.nf-cta{transition:transform .25s ease,box-shadow .25s ease}
.nf-cta:hover{transform:translateY(-2px);box-shadow:0 10px 30px color-mix(in srgb,var(--accent) 55%,transparent)}
.nf-card{transition:border-color .3s ease,background .3s ease,transform .3s ease}
.nf-card:hover{border-color:rgba(167,139,250,.5);background:rgba(124,92,250,.08);transform:translateY(-3px)}
.motion .nf-flow{stroke-dasharray:4 10;animation:nf-flow 1.4s linear infinite}
.motion .nf-drift{animation:nf-drift 5s ease-in-out infinite}
.motion .nf-flicker{animation:nf-flicker 2.4s steps(1) infinite}
.motion .nf-blink{animation:nf-blink 1.6s ease-in-out infinite}
@keyframes nf-flow{to{stroke-dashoffset:-28}}
@keyframes nf-drift{0%,100%{transform:translate(0,0) rotate(-4deg)}50%{transform:translate(10px,-12px) rotate(3deg)}}
@keyframes nf-flicker{0%,100%{opacity:.9}42%{opacity:.25}44%{opacity:.9}70%{opacity:.4}72%{opacity:.9}}
@keyframes nf-blink{0%,100%{opacity:1}50%{opacity:.3}}
@media (prefers-reduced-motion:reduce){.nf *{animation:none!important;transition:none!important}}
</style>
