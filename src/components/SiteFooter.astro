---
import { NEWSLETTER_ENDPOINT } from '../data/site';
---
<div class="ft">
  <footer class="ft-foot" style="position: relative; border-top: 1px solid rgba(255,255,255,.07)">
    <div style="width: 100%; max-width: 1280px; margin: 0 auto; padding: 56px 32px 24px; display: flex; flex-wrap: wrap; gap: 48px; justify-content: space-between">
      <div style="flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
        <span style="font-size: 18px; font-weight: 600">Stay connected</span>
        <p style="margin: 0; font-size: 15px; line-height: 1.55; color: #A9A3C2; max-width: 420px">Updates no more than quarterly on systems, growth and projects.</p>
                  <form data-newsletter style="display: flex; flex-wrap: wrap; gap: 10px; max-width: 460px">
            <label for="ft-email" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">Email address</label>
            <input class="ft-input" id="ft-email" type="email" required placeholder="you@company.com" style="flex: 1 1 220px; min-width: 0; min-height: 48px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.04); color: #F4F2FF; font: inherit; font-size: 15px">
            <button type="submit" class="ft-cta" style="min-height: 48px; padding: 0 22px; border-radius: 999px; border: 0; background: var(--accent); color: #FFFFFF; font: inherit; font-size: 15px; font-weight: 500; cursor: pointer">Subscribe</button>
          </form>
          <p data-nl-done hidden style="margin: 0; display: inline-flex; align-items: center; gap: 10px; font-size: 15px; color: #F4F2FF">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg>
            Thanks, you're on the list.
          </p>
          <p data-nl-error hidden style="margin: 0; font-size: 14px; color: #FCA5A5">Something went wrong. Please email <a href="mailto:yaroslav@korets.net">yaroslav@korets.net</a>.</p>
        <span style="font-size: 13px; color: #8B84A8">No spam. Unsubscribe anytime.</span>
      </div>

      <div style="flex: 0 1 auto; display: flex; flex-direction: column; gap: 16px">
        <span style="font-size: 18px; font-weight: 600">Follow</span>
        <nav aria-label="Social" style="display: flex; flex-wrap: wrap; gap: 10px">
          <a class="ft-soc" href="https://www.linkedin.com/in/yaroslavkorets/" aria-label="LinkedIn" style="width: 48px; height: 48px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); color: #C9C3DE; display: inline-flex; align-items: center; justify-content: center">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7"></path><path d="M8 7v.01"></path><path d="M12 17v-4a2 2 0 0 1 4 0v4"></path><path d="M12 10v7"></path></svg>
          </a>
          <a class="ft-soc" href="https://www.facebook.com/yaroslav.korets/" aria-label="Facebook" style="width: 48px; height: 48px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); color: #C9C3DE; display: inline-flex; align-items: center; justify-content: center">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z"></path></svg>
          </a>
          <a class="ft-soc" href="https://www.instagram.com/yarokorets/" aria-label="Instagram" style="width: 48px; height: 48px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); color: #C9C3DE; display: inline-flex; align-items: center; justify-content: center">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5v.01"></path></svg>
          </a>
          <a class="ft-soc" href="https://x.com/ykorets" aria-label="X" style="width: 48px; height: 48px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); color: #C9C3DE; display: inline-flex; align-items: center; justify-content: center">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l16 16"></path><path d="M20 4L4 20"></path></svg>
          </a>
          <a class="ft-soc" href="mailto:yaroslav@korets.net" aria-label="Email" style="width: 48px; height: 48px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); color: #C9C3DE; display: inline-flex; align-items: center; justify-content: center">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </a>
        </nav>
        <nav aria-label="Site" style="display: flex; flex-direction: column; gap: 8px; font-size: 14px">
          <a href="/ai-implementation/" style="color: #C9C3DE; text-decoration: none">AI implementation</a>
          <a href="/ai-for-event-rental-companies/" style="color: #C9C3DE; text-decoration: none">AI for event rental companies</a>
          <a href="/case/stretch-tent/" style="color: #C9C3DE; text-decoration: none">Case study: Stretch Tent</a>
          <a href="/writing/" style="color: #C9C3DE; text-decoration: none">Writing</a>
        </nav>
        <a href="/cv/" style="font-size: 15px; color: #C9C3DE; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center">Full CV →</a>
      </div>
    </div>

    <div aria-hidden="true" style="width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 32px; overflow: hidden">
      <div style="font-size: clamp(40px, 13vw, 200px); line-height: .85; letter-spacing: -0.06em; font-weight: 700; background: linear-gradient(180deg, rgba(167,139,250,.35), rgba(167,139,250,0)); -webkit-background-clip: text; background-clip: text; color: transparent; white-space: nowrap; user-select: none">YARO KORETS</div>
    </div>

    <div style="width: 100%; max-width: 1280px; margin: 0 auto; padding: 20px 32px 32px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 12px; letter-spacing: .06em; color: #8B84A8">
      <span>© 2026 YAROSLAV (YARO) KORETS · <a href="/privacy/" style="color: inherit">PRIVACY</a> · <a href="#" data-cc-open style="color: inherit">COOKIE SETTINGS</a></span>
      <span>AI FOR PROFITABLE GROWTH · LOS ANGELES</span>
    </div>
  </footer>
</div>

<script define:vars={{ endpoint: NEWSLETTER_ENDPOINT }}>
  document.querySelectorAll('form[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const box = form.parentElement;
      const input = form.querySelector('input[type=email]');
      const btn = form.querySelector('button');
      const email = input.value.trim();
      if (!email) return;
      btn.disabled = true; btn.textContent = 'Sending…';
      box.querySelector('[data-nl-error]').hidden = true;
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        box.querySelector('[data-nl-done]').hidden = false;
      } catch (err) {
        btn.disabled = false; btn.textContent = 'Subscribe';
        box.querySelector('[data-nl-error]').hidden = false;
      }
    });
  });
</script>

<style is:global>
.ft{background:#0B0A12;color:#F4F2FF;font-family:'Geist Variable',Inter,system-ui,sans-serif;--accent:#6D4AF6}
.ft *{box-sizing:border-box}
.ft-cta{transition:transform .25s ease,box-shadow .25s ease}
.ft-cta:hover{transform:translateY(-2px);box-shadow:0 10px 30px color-mix(in srgb,var(--accent) 55%,transparent)}
.ft-soc{transition:color .25s ease,border-color .25s ease,background .25s ease}
.ft-soc:hover{color:#FFFFFF;border-color:rgba(167,139,250,.6);background:rgba(124,92,250,.15)}
.ft-foot a:hover{color:#FFFFFF}
.ft-input:focus{outline:2px solid #A78BFA;outline-offset:2px}
form[hidden],[data-nl-done][hidden],[data-nl-error][hidden]{display:none!important}
</style>
