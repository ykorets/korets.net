---
// Generated from the approved design canvas (Businesses.dc.html); edit freely.
const { state = {}, props: p = {} } = Astro.props;
class DCLogic { constructor(props) { this.props = props || {}; this.state = {}; } setState() {} componentDidMount() {} }
class Component extends DCLogic {
  renderVals() {
    const motion = this.props.motion ?? true;
    return {
      accent: this.props.accent ?? '#6D4AF6',
      rootClass: motion ? 'bz motion' : 'bz'
    };
  }
}
const c = new Component(p);
Object.assign(c.state, state);
const v = c.renderVals();
---
<div class={v.rootClass} style={`--accent: ${v.accent}; position: relative; min-height: 900px; background: #0B0A12; color: #F4F2FF; font-family: 'Geist Variable', Inter, system-ui, sans-serif; overflow: hidden; border-top: 1px solid rgba(255,255,255,.06)`}>
  <div style="width: 100%; max-width: 1280px; margin: 0 auto; padding: 96px 32px; display: flex; flex-direction: column; gap: 48px">

    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
      <div style="display: flex; flex-direction: column; gap: 20px; max-width: 640px">
        <span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 12px; letter-spacing: .12em; color: #A78BFA">MY BUSINESSES</span>
        <h2 style="margin: 0; font-size: clamp(40px, 5vw, 64px); line-height: 1.02; letter-spacing: -0.04em; font-weight: 600">The product and<br>the business behind it.</h2>
      </div>
      <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #A9A3C2; max-width: 400px">Growth Control is built and tested inside a real operating company before it reaches a client.</p>
    </div>

    <div class="bz-bento" style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(220px, auto); gap: 20px">

      <article class="bz-tile" style="grid-column: span 2; grid-row: span 2; position: relative; overflow: hidden; border-radius: 28px; background: linear-gradient(160deg, rgba(109,74,246,.22) 0%, rgba(20,17,36,.9) 55%); border: 1px solid rgba(167,139,250,.25); padding: 32px; display: flex; flex-wrap: wrap; gap: 28px">
        <div style="flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 28px">
          <div style="display: flex; flex-direction: column; gap: 16px">
            <span style="align-self: flex-start; font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px; letter-spacing: .1em; color: #E9E3FF; padding: 6px 10px; border-radius: 999px; background: rgba(124,92,250,.3)">FOUNDER · PRODUCT</span>
            <h3 style="margin: 0; font-size: 40px; line-height: 1; letter-spacing: -0.03em; font-weight: 600">Growth Control</h3>
            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #C9C3DE">Connects advertising, inquiries, CRM, calls, quotes and follow-up into one configured sales process.</p>
            <div style="display: flex; flex-wrap: wrap; gap: 8px">
              <span style="font-size: 12px; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); color: #C9C3DE">AI</span>
              <span style="font-size: 12px; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); color: #C9C3DE">Marketing</span>
              <span style="font-size: 12px; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); color: #C9C3DE">Sales</span>
            </div>
          </div>
          <a class="bz-link" href="https://growthcontrol.app" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 500; color: #EDE9FE; text-decoration: none; min-height: 44px">
            See how Growth Control works
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 5 7 7-7 7"></path></svg>
          </a>
        </div>

        <div aria-label="Sales process stages" style="flex: 0 1 220px; min-width: 200px; position: relative; display: flex; flex-direction: column; gap: 10px; padding-left: 22px">
          <div aria-hidden="true" style="position: absolute; left: 6px; top: 4%; bottom: 6%; width: 2px; border-radius: 2px; background: rgba(167,139,250,.2)"></div>
          <div class="bz-dot" aria-hidden="true" style="position: absolute; left: 2px; top: 4%; width: 10px; height: 10px; border-radius: 50%; background: #EDE9FE; box-shadow: 0 0 14px #A78BFA"></div>
          <div class="bz-chip" style="animation-delay: 0s; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); color: #A9A3C2; font-size: 14px; display: flex; justify-content: space-between"><span>Advertising</span><span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px">01</span></div>
          <div class="bz-chip" style="animation-delay: .6s; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); color: #A9A3C2; font-size: 14px; display: flex; justify-content: space-between"><span>Inquiry</span><span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px">02</span></div>
          <div class="bz-chip" style="animation-delay: 1.2s; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); color: #A9A3C2; font-size: 14px; display: flex; justify-content: space-between"><span>CRM</span><span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px">03</span></div>
          <div class="bz-chip" style="animation-delay: 1.8s; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); color: #A9A3C2; font-size: 14px; display: flex; justify-content: space-between"><span>Call</span><span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px">04</span></div>
          <div class="bz-chip" style="animation-delay: 2.4s; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); color: #A9A3C2; font-size: 14px; display: flex; justify-content: space-between"><span>Quote</span><span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px">05</span></div>
          <div class="bz-chip" style="animation-delay: 3s; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); color: #A9A3C2; font-size: 14px; display: flex; justify-content: space-between"><span>Follow-up</span><span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px">06</span></div>
        </div>
      </article>

      <article class="bz-tile" style="grid-column: span 2; position: relative; overflow: hidden; border-radius: 28px; background: rgba(20,17,36,.85); border: 1px solid rgba(255,255,255,.08); display: flex; flex-wrap: wrap">
        <div style="flex: 1 1 240px; min-width: 0; padding: 28px; display: flex; flex-direction: column; gap: 14px; justify-content: space-between">
          <div style="display: flex; flex-direction: column; gap: 12px">
            <span style="align-self: flex-start; font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px; letter-spacing: .1em; color: #C4B5FD">CTO &amp; CO-FOUNDER · SINCE 2018</span>
            <h3 style="margin: 0; font-size: 30px; line-height: 1.05; letter-spacing: -0.02em; font-weight: 600">Stretch Tent</h3>
            <p style="margin: 0; font-size: 15px; line-height: 1.55; color: #A9A3C2">Tent rentals and sales in Southern California, shipping worldwide. The company where Growth Control is built and tested.</p>
          </div>
          <a class="bz-link" href="https://stretch-tent.net" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; color: #EDE9FE; text-decoration: none; min-height: 44px">
            stretch-tent.net
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
          </a>
        </div>
        <div style="flex: 1 1 220px; min-height: 220px; position: relative; overflow: hidden; border-left: 1px solid rgba(255,255,255,.06)">
          <img src="/img/stretch-tent-night.jpg" alt="Stretch tent over a festival stage at night, crowd in front" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover">
          <div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,17,36,.55), rgba(20,17,36,0) 45%), linear-gradient(0deg, rgba(109,74,246,.18), rgba(109,74,246,0))"></div>
        </div>
      </article>

      <article class="bz-tile" style="position: relative; overflow: hidden; border-radius: 28px; background: rgba(20,17,36,.85); border: 1px solid rgba(255,255,255,.08); padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px">
        <div aria-hidden="true" class="bz-spin" style="position: absolute; right: -60px; top: -60px; width: 180px; height: 180px; border-radius: 50%; border: 1px dashed rgba(167,139,250,.3)"></div>
        <span style="font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px; letter-spacing: .1em; color: #8B84A8">OPERATING SINCE</span>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <span style="font-size: 64px; line-height: 1; letter-spacing: -0.04em; font-weight: 600; background: linear-gradient(100deg, #C4B5FD, #F3E8FF); -webkit-background-clip: text; background-clip: text; color: transparent">2018</span>
          <span style="font-size: 14px; color: #A9A3C2">A real company, not a demo environment.</span>
        </div>
      </article>

      <article class="bz-tile" style="position: relative; overflow: hidden; border-radius: 28px; background: rgba(20,17,36,.85); border: 1px solid rgba(255,255,255,.08); padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px">
        <span style="display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono Variable', ui-monospace, monospace; font-size: 11px; letter-spacing: .1em; color: #8B84A8">
          <span class="bz-blink" style="width: 6px; height: 6px; border-radius: 50%; background: #34D399; display: inline-block"></span>
          CASE STUDY
        </span>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <span style="font-size: 30px; line-height: 1.05; letter-spacing: -0.02em; font-weight: 600; color: #F4F2FF">An AI-run office</span>
          <span style="font-size: 14px; color: #A9A3C2">100 leads in the first two weeks. Only the install crews are human.</span>
        </div>
        <a class="bz-link" href="/case/stretch-tent/" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; color: #EDE9FE; text-decoration: none; min-height: 44px">
          Read the case
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 5 7 7-7 7"></path></svg>
        </a>
      </article>

    </div>
  </div>
</div>

<style is:global>
.bz *{box-sizing:border-box}
.bz-tile{transition:transform .4s cubic-bezier(.2,.7,.2,1),border-color .4s ease,box-shadow .4s ease}
.bz-tile:hover{transform:translateY(-4px);border-color:rgba(167,139,250,.45);box-shadow:0 20px 60px rgba(109,74,246,.18)}
.bz-link{transition:gap .25s ease,color .25s ease}
.bz-link:hover{gap:14px;color:#FFFFFF}
.motion .bz-chip{animation:bz-chip 4.2s ease-in-out infinite}
.motion .bz-dot{animation:bz-dot 4.2s linear infinite}
.motion .bz-blink{animation:bz-blink 1.6s ease-in-out infinite}
.motion .bz-spin{animation:bz-spin 18s linear infinite}
@keyframes bz-chip{0%,100%{border-color:rgba(255,255,255,.08);background:rgba(255,255,255,.02);color:#A9A3C2}8%,20%{border-color:rgba(167,139,250,.7);background:rgba(124,92,250,.2);color:#FFFFFF}30%{border-color:rgba(255,255,255,.08);background:rgba(255,255,255,.02);color:#A9A3C2}}
@keyframes bz-dot{0%{top:4%;opacity:0}5%{opacity:1}90%{opacity:1}100%{top:94%;opacity:0}}
@keyframes bz-blink{0%,100%{opacity:1}50%{opacity:.3}}
@keyframes bz-spin{to{transform:rotate(360deg)}}
@media (max-width:900px){.bz-bento{grid-template-columns:minmax(0,1fr)!important}.bz-bento>*{grid-column:auto!important;grid-row:auto!important}}
@media (prefers-reduced-motion:reduce){.motion *{animation:none!important}}
</style>
