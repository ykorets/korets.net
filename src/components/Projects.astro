---
// Generated from the approved design canvas (Projects.dc.html); edit freely.
const { state = {}, props: p = {} } = Astro.props;
class DCLogic { constructor(props) { this.props = props || {}; this.state = {}; } setState() {} componentDidMount() {} }
class Component extends DCLogic {
  renderVals() {
    const motion = this.props.motion ?? true;
    return {
      accent: this.props.accent ?? '#6D4AF6',
      rootClass: motion ? 'pj motion' : 'pj',
      agents: [
        ['Figaro', 'Lead response: Yelp, website forms, calls and texts'],
        ['Cyrano', 'Live call copilot: briefs, suggestions, follow-ups'],
        ['Marco', 'Email outreach campaigns'],
        ['Hunter', 'Paid search campaigns'],
        ['Oscar', 'Social channels and review monitoring'],
        ['Pacioli', 'Invoicing, every invoice owner-approved'],
        ['Midas', 'Pricing']
      ].map((x, i) => ({ name: x[0], role: x[1], initial: x[0].charAt(0), delay: (i * 1) + 's' }))
    };
  }
}
const c = new Component(p);
Object.assign(c.state, state);
const v = c.renderVals();
