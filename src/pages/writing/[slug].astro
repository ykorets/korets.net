---
import Base from '../../layouts/Base.astro';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import articles from '../../data/articles.json';

export function getStaticPaths() {
  return articles.map((a, i) => ({ params: { slug: a.slug }, props: { i } }));
}
const { i } = Astro.props as { i: number };
const a = articles[i];
const prev = articles[i - 1];
const next = articles[i + 1];
const url = new URL(`/writing/${a.slug}/`, Astro.site).href;
const short = a.metaTitle.replace(/ \| Yaroslav Korets$/, '');
---
<Base title={`${short} — Yaro Korets`} description={a.description} path={`/writing/${a.slug}/`} type="article" image="/writing/built-shipped-running-social.png" current="Writing" jsonld={a.jsonld}>
<div class="ar">
  <div aria-hidden="true" class="ar-bar"><div class="ar-progress" data-progress></div></div>

  <section class="ar-head">
    <div aria-hidden="true" class="ar-glow"></div>
    <div class="ar-head-inner">
      <nav aria-label="Breadcrumb" class="ar-crumbs"><a href="/writing/">Writing</a><span>/</span><a href="/writing/built-shipped-running/">Built. Shipped. Running.</a></nav>
      <span class="ar-eyebrow">{a.eyebrow.toUpperCase()}</span>
      <h1>{a.title}</h1>
      <p class="ar-lead">{a.lead}</p>
      <div class="ar-meta">
        <span class="ar-author"><img src="/img/yaro-portrait.jpg" alt="" width="36" height="36"><span>Yaro Korets</span></span>
        <span>{a.date}</span><span>{a.readTime}</span>
      </div>
      <div class="ar-receipt">RECEIPT · {a.receipt}</div>
    </div>
  </section>

  <div class="ar-wrap">
    <aside class="ar-aside" aria-label="On this page">
      <span class="ar-label">ON THIS PAGE</span>
      <nav class="ar-toc" data-toc>
        {a.toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
        {a.faq.length > 0 && <a href="#questions">Questions operators ask</a>}
      </nav>
      <div class="ar-share">
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} aria-label="Share on LinkedIn" target="_blank" rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7"></path><path d="M8 7v.01"></path><path d="M12 17v-4a2 2 0 0 1 4 0v4"></path><path d="M12 10v7"></path></svg>
        </a>
        <button type="button" aria-label="Copy link" data-copy={url}>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
        </button>
      </div>
    </aside>

    <article class="ar-prose">
      <Fragment set:html={a.body} />

      {a.faq.length > 0 && (
        <section class="ar-faq" aria-labelledby="questions">
          <span class="ar-label">DIRECT ANSWERS</span>
          <h2 id="questions">Questions operators ask</h2>
          {a.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div set:html={f.a} />
            </details>
          ))}
        </section>
      )}

      <div class="ar-cta-box">
        <span class="ar-cta-title">Find the operating process worth rebuilding first.</span>
        <span class="ar-cta-text">Bring one workflow where money, data or deadlines are attached. We'll map its last mile and a first step.</span>
        <a class="ar-cta" href="/#book">Discuss your operation</a>
      </div>

      <nav aria-label="Series" class="ar-series">
        {prev ? (
          <a class="ar-next" href={`/writing/${prev.slug}/`}>
            <span class="ar-label">← PART {prev.part} OF 8</span><span class="ar-next-title">{prev.title}</span>
          </a>
        ) : (
          <a class="ar-next" href="/writing/built-shipped-running/">
            <span class="ar-label">← SERIES INDEX</span><span class="ar-next-title">Built. Shipped. Running.</span>
          </a>
        )}
        {next ? (
          <a class="ar-next ar-next-on" href={`/writing/${next.slug}/`}>
            <span class="ar-label">NEXT · PART {next.part} OF 8 →</span><span class="ar-next-title">{next.title}</span>
          </a>
        ) : (
          <a class="ar-next ar-next-on" href="/writing/">
            <span class="ar-label">ALL WRITING →</span><span class="ar-next-title">Back to all field notes</span>
          </a>
        )}
      </nav>
    </article>
  </div>
</div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.ar-prose');
  const onScroll = () => {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight)));
    bar.style.width = (p * 100).toFixed(1) + '%';
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] a'));
  const targets = links.map((l) => document.querySelector(decodeURIComponent(l.hash))).filter(Boolean) as Element[];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((l) => l.classList.toggle('is-active', l.hash === '#' + e.target.id));
    });
  }, { rootMargin: '-20% 0px -70% 0px' });
  targets.forEach((t) => io.observe(t));

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.setAttribute('aria-label', 'Link copied'); b.classList.add('is-done'); } catch {}
  }));
</script>

<style is:global>
.ar{--accent:#6D4AF6;position:relative;background:#0B0A12;color:#F4F2FF}
.ar *{box-sizing:border-box}
.ar-bar{position:sticky;top:0;z-index:60;height:3px;background:rgba(255,255,255,.06);margin-top:-3px}
.ar-progress{height:100%;width:0;background:linear-gradient(90deg,var(--accent),#C4B5FD);box-shadow:0 0 12px var(--accent)}
.ar-head{position:relative;width:100%;max-width:1280px;margin:0 auto;padding:56px 32px 40px}
.ar-glow{position:absolute;left:20%;top:-40%;width:60%;height:150%;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 22%,transparent) 0%,transparent 62%);filter:blur(30px);pointer-events:none}
.ar-head-inner{position:relative;max-width:880px;display:flex;flex-direction:column;gap:22px}
.ar-crumbs{display:flex;gap:10px;font-family:'Geist Mono Variable',ui-monospace,monospace;font-size:12px;letter-spacing:.08em;color:#8B84A8;text-transform:uppercase}
.ar-crumbs a{color:#A9A3C2;text-decoration:none}.ar-crumbs a:hover{color:#fff}
.ar-eyebrow,.ar-label{font-family:'Geist Mono Variable',ui-monospace,monospace;font-size:12px;letter-spacing:.12em;color:#A78BFA}
.ar-label{font-size:11px;color:#8B84A8}
.ar h1{margin:0;font-size:clamp(40px,5.5vw,72px);line-height:1;letter-spacing:-.045em;font-weight:600}
.ar-lead{margin:0;font-family:'Newsreader Variable',Georgia,serif;font-style:italic;font-size:24px;line-height:1.45;color:#C9C3DE}
.ar-meta{display:flex;flex-wrap:wrap;align-items:center;gap:18px;font-size:14px;color:#A9A3C2}
.ar-author{display:inline-flex;align-items:center;gap:10px;color:#F4F2FF;font-weight:500}
.ar-author img{width:36px;height:36px;border-radius:50%;object-fit:cover;border:1px solid rgba(167,139,250,.4)}
.ar-receipt{align-self:flex-start;font-family:'Geist Mono Variable',ui-monospace,monospace;font-size:12px;line-height:1.5;color:#C4B5FD;padding:10px 14px;border-radius:12px;background:rgba(124,92,250,.12);border:1px solid rgba(167,139,250,.3)}
.ar-wrap{width:100%;max-width:1280px;margin:0 auto;padding:24px 32px 96px;display:flex;gap:64px;align-items:flex-start}
.ar-aside{flex:0 0 240px;position:sticky;top:96px;display:flex;flex-direction:column;gap:14px}
.ar-toc{display:flex;flex-direction:column;gap:2px;font-size:14px;line-height:1.4}
.ar-toc a{color:#8B84A8;text-decoration:none;padding:8px 0 8px 14px;border-left:2px solid rgba(255,255,255,.08);transition:color .2s ease,border-color .2s ease}
.ar-toc a:hover{color:#fff}
.ar-toc a.is-active{color:#fff;border-left-color:#A78BFA}
.ar-share{margin-top:10px;display:flex;gap:8px}
.ar-share a,.ar-share button{width:44px;height:44px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:transparent;color:#C9C3DE;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.ar-share a:hover,.ar-share button:hover{color:#fff;border-color:rgba(167,139,250,.6)}
.ar-share .is-done{color:#34D399;border-color:#34D399}
.ar-prose{flex:1 1 auto;min-width:0;max-width:720px;font-family:'Newsreader Variable',Georgia,serif;font-size:21px;line-height:1.7;color:#DDD8EE;display:flex;flex-direction:column;gap:26px}
.ar-prose section{display:flex;flex-direction:column;gap:22px}
.ar-prose p{margin:0}
.ar-prose h2{margin:12px 0 0;font-family:'Geist Variable',sans-serif;font-size:30px;line-height:1.2;letter-spacing:-.02em;font-weight:600;color:#F4F2FF;scroll-margin-top:110px}
.ar-prose strong{color:#F4F2FF}
.ar-prose a{color:#C4B5FD}
.ar-prose blockquote{margin:8px 0;padding:4px 0 4px 26px;border-left:3px solid #A78BFA;font-size:28px;line-height:1.4;font-style:italic;color:#F4F2FF}
.ar-prose blockquote p{margin:0}
.ar-prose ul,.ar-prose ol{margin:0;padding-left:1.2em;display:flex;flex-direction:column;gap:10px}
.ar-prose table{width:100%;border-collapse:collapse;font-family:'Geist Variable',sans-serif;font-size:15px;line-height:1.5;color:#C9C3DE;border-radius:16px;overflow:hidden;background:rgba(20,17,36,.9);border:1px solid rgba(167,139,250,.22)}
.ar-prose th,.ar-prose td{text-align:left;vertical-align:top;padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.06)}
.ar-prose th{font-family:'Geist Mono Variable',ui-monospace,monospace;font-size:11px;letter-spacing:.08em;color:#A78BFA;font-weight:500;text-transform:uppercase}
.ar-prose .comparison-table{overflow-x:auto}
.ar-faq{margin-top:12px;padding:28px;border-radius:24px;background:rgba(20,17,36,.85);border:1px solid rgba(255,255,255,.08);font-family:'Geist Variable',sans-serif;gap:14px!important}
.ar-faq h2{margin:0}
.ar-faq details{border-top:1px solid rgba(255,255,255,.08);padding:14px 0 0}
.ar-faq summary{cursor:pointer;font-size:18px;font-weight:600;color:#F4F2FF;list-style:none;display:flex;justify-content:space-between;gap:16px}
.ar-faq summary::after{content:'+';color:#A78BFA;font-weight:400;transition:transform .25s ease}
.ar-faq details[open] summary::after{transform:rotate(45deg)}
.ar-faq summary::-webkit-details-marker{display:none}
.ar-faq details div{padding-top:10px;font-size:16px;line-height:1.6;color:#C9C3DE}
.ar-cta-box{margin-top:24px;border-radius:24px;background:linear-gradient(140deg,rgba(109,74,246,.3),rgba(20,17,36,.95) 60%);border:1px solid rgba(167,139,250,.3);padding:32px;font-family:'Geist Variable',sans-serif;display:flex;flex-direction:column;gap:14px}
.ar-cta-title{font-size:26px;line-height:1.2;letter-spacing:-.02em;font-weight:600;color:#fff}
.ar-cta-text{font-size:16px;line-height:1.6;color:#C9C3DE}
.ar-cta{align-self:flex-start;color:#fff;text-decoration:none;background:var(--accent);padding:14px 24px;border-radius:999px;font-size:16px;font-weight:500;min-height:48px;display:inline-flex;align-items:center;transition:transform .25s ease,box-shadow .25s ease}
.ar .ar-cta:hover{color:#fff;transform:translateY(-2px);box-shadow:0 10px 30px color-mix(in srgb,var(--accent) 55%,transparent)}
.ar-series{margin-top:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;font-family:'Geist Variable',sans-serif}
.ar-next{text-decoration:none;color:inherit;border-radius:18px;border:1px solid rgba(255,255,255,.08);background:rgba(20,17,36,.85);padding:20px;display:flex;flex-direction:column;gap:6px;transition:transform .35s ease,border-color .35s ease}
.ar-next:hover{transform:translateY(-3px);border-color:rgba(167,139,250,.45)}
.ar-next-on{border-color:rgba(167,139,250,.3);background:rgba(124,92,250,.1);text-align:right}
.ar-next-on .ar-label{color:#C4B5FD}
.ar-next-title{font-size:17px;font-weight:600;color:#F4F2FF}
@media (max-width:1000px){.ar-aside{display:none}.ar-wrap{gap:0}}
@media (max-width:640px){.ar-head,.ar-wrap{padding-left:20px;padding-right:20px}.ar-prose{font-size:19px}.ar-lead{font-size:20px}.ar-prose blockquote{font-size:23px}.ar-faq{padding:20px}}
</style>
