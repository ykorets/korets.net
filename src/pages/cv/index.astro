---
import Base from '../../layouts/Base.astro';
import CV from '../../components/CV.astro';
import { PERSON_ID, SITE, breadcrumbs } from '../../data/person';
const graph = [
  { '@type': 'ProfilePage', '@id': `${SITE}/cv/#page`, url: `${SITE}/cv/`, name: 'CV — Yaro (Yaroslav) Korets', mainEntity: { '@id': PERSON_ID }, dateModified: '2026-11-14' },
