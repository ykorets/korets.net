---
import Base from '../../layouts/Base.astro';
import Case from '../../components/Case.astro';
import { PERSON_ID, SITE, breadcrumbs } from '../../data/person';
const graph = [
  { '@type': 'Article', '@id': `${SITE}/case/stretch-tent/#article`, headline: 'The office is AI. The crew is human: how Stretch Tent runs on AI agents', description: 'Case study: Stretch Tent runs marketing, sales, front desk and back office on Growth Control AI agents; only the install crews are human.', author: { '@id': PERSON_ID }, publisher: { '@id': PERSON_ID }, datePublished: '2026-11-14T12:00:00-08:00', image: `${SITE}/img/stretch-tent-night.jpg`, mainEntityOfPage: `${SITE}/case/stretch-tent/`, about: [{ '@type': 'Organization', name: 'Stretch Tent', url: 'https://www.stretch-tent.net/' }, { '@type': 'SoftwareApplication', name: 'Growth Control', url: 'https://growthcontrol.app/', applicationCategory: 'BusinessApplication' }] },
