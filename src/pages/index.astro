---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Businesses from '../components/Businesses.astro';
import Projects from '../components/Projects.astro';
import Story from '../components/Story.astro';
import Community from '../components/Community.astro';
import Principles from '../components/Principles.astro';
import Booking from '../components/Booking.astro';
import Contact from '../components/Contact.astro';
import Stateful from '../components/Stateful.astro';
---
<Base title="Yaro Korets (Yaroslav Korets) — Forward Deployed Engineer" description="Yaro (Yaroslav) Korets is a Forward Deployed Engineer in Los Angeles and founder of Growth Control. He builds and deploys AI workflows for tax, CPA, and bookkeeping firms." path="/">
  <Hero />
  <Stateful id="work" indexable component={Process} autoplay={3400} states={[0, 1, 2, 3, 4].map((s) => ({ s }))} />
  <div id="businesses"><Businesses /></div>
  <div id="projects"><Projects /></div>
  <Stateful id="story" indexable component={Story} autoplay={5200} states={[0, 1, 2, 3, 4, 5].map((s) => ({ s }))} />
  <div id="community"><Community /></div>
  <Stateful id="principles" indexable component={Principles} named={{ showThink: 0, showWork: 1 }} states={[{ tab: 'think' }, { tab: 'work' }]} />
  <div id="book"><Booking /></div>
  <div id="contact"><Contact /></div>
</Base>
