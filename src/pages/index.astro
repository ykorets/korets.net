---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Businesses from '../components/Businesses.astro';
import Projects from '../components/Projects.astro';
import Story from '../components/Story.astro';
import Community from '../components/Community.astro';
import Principles from '../components/Principles.astro';
import Booking from '../components/Booking.astro';
import Contact from '../components/Contact.astro';
import Stateful from '../components/Stateful.astro';
const jsonld = "{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Person\", \"@id\": \"https://korets.net/#person\", \"name\": \"Yaroslav Korets\", \"alternateName\": \"Yaro Korets\", \"url\": \"https://korets.net/\", \"description\": \"AI implementation for profitable growth across marketing, sales, finance and operations. Founder of Growth Control and CTO & Co-Founder of Stretch Tent.\", \"sameAs\": [\"https://www.linkedin.com/in/yaroslavkorets/\", \"https://www.instagram.com/yarokorets/\", \"https://www.facebook.com/yaroslav.korets/\", \"https://x.com/ykorets\"], \"worksFor\": [{\"@type\": \"Organization\", \"name\": \"Growth Control\", \"url\": \"https://growthcontrol.app/\"}, {\"@type\": \"Organization\", \"name\": \"Stretch Tent\", \"url\": \"https://www.stretch-tent.net/\"}], \"image\": \"https://korets.net/img/yaro-portrait.jpg\", \"jobTitle\": \"AI Implementation Engineer\"}, {\"@type\": \"WebSite\", \"@id\": \"https://korets.net/#website\", \"name\": \"Yaro Korets\", \"url\": \"https://korets.net/\", \"about\": {\"@id\": \"https://korets.net/#person\"}, \"inLanguage\": \"en\"}]}";
---
<Base title="Yaro Korets — AI for profitable growth" description="Practical AI implementation across marketing, sales, finance and operations. Founder of Growth Control and CTO & Co-Founder of Stretch Tent." path="/" jsonld={jsonld}>
  <Hero />
  <Stateful id="work" component={Process} autoplay={3400} states={[0, 1, 2, 3, 4].map((s) => ({ s }))} />
  <div id="businesses"><Businesses /></div>
  <div id="projects"><Projects /></div>
  <Stateful id="story" component={Story} autoplay={5200} states={[0, 1, 2, 3, 4, 5].map((s) => ({ s }))} />
  <div id="community"><Community /></div>
  <Stateful id="principles" component={Principles} named={{ showThink: 0, showWork: 1 }} states={[{ tab: 'think' }, { tab: 'work' }]} />
  <div id="book"><Booking /></div>
  <div id="contact"><Contact /></div>
</Base>
